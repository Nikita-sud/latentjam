# Kotlin/Native bindings for the ONNX Runtime C API.
#
# The C API rather than the C++ or Objective-C one: it is the ABI ONNX Runtime
# commits to, it is what the Android binding ultimately calls too, and it maps
# onto cinterop without a C++ shim.
#
# Header search paths and the static library come from build.gradle.kts, so this
# file stays free of machine-specific paths. Run tools/fetch_onnxruntime.sh
# first — the framework is not vendored into the repository.
headers = onnxruntime_c_api.h coreml_provider_factory.h
headerFilter = onnxruntime_*.h coreml_provider_factory.h
package = onnxruntime
language = C
