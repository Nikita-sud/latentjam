<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Media access for the library scanner: split by API level. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Background playback via the Media3 session service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Library analysis runs for minutes; dataSync rather than mediaPlayback
         because it is unrelated to whether anything is playing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Attaching the system equalizer effect to our audio session. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- State leaves the device only through the user's explicit backup export. -->
    <application
        android:name="io.github.nikitasud.latentjam.app.LatentJamApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LatentJam">

        <!-- Android Auto: this is a media app; browsing goes through the
             Media3 library session in PlaybackService. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Fully-qualified: the activity class is compiled in :composeApp
             (androidMain), not in this zero-source packaging module. -->
        <activity
            android:name="io.github.nikitasud.latentjam.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Class compiled in :core:playback (androidMain); hosts the
             ExoPlayer + MediaSession for background playback. -->
        <service
            android:name="io.github.nikitasud.latentjam.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <!-- Class compiled in :composeApp (androidMain); keeps the process alive
             while the library is analysed so the progress it reports is true. -->
        <service
            android:name="io.github.nikitasud.latentjam.app.IndexingService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- Quick Settings tile: play/pause from the shade. Class compiled in
             :core:playback (androidMain). -->
        <service
            android:name="io.github.nikitasud.latentjam.playback.PlaybackTileService"
            android:exported="true"
            android:icon="@drawable/ic_music_mark"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lets Bluetooth/headset and System UI media buttons restart the Media3 service after
             the app process has been reclaimed. PlaybackService supplies the saved resumption
             media items; the receiver itself performs no library or trust decisions. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Pulse Strip: compact, live metadata and transport controls. This keeps the original
             provider class so existing widgets upgrade in place instead of disappearing. -->
        <receiver
            android:name="io.github.nikitasud.latentjam.app.PlaybackWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name_pulse">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="${applicationId}.action.PLAYBACK_WIDGET_STATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playback_info" />
        </receiver>

        <!-- Cover Portal: square, artwork-first widget. -->
        <receiver
            android:name="io.github.nikitasud.latentjam.app.ArtworkPlaybackWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name_portal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playback_artwork_info" />
        </receiver>

        <!-- SMART Deck: detailed 4x2 player with repeat and three-state shuffle. -->
        <receiver
            android:name="io.github.nikitasud.latentjam.app.DeckPlaybackWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name_deck">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playback_deck_info" />
        </receiver>

        <!-- Explicit-only repeat/SMART commands from the detailed widget. -->
        <receiver
            android:name="io.github.nikitasud.latentjam.app.PlaybackWidgetActionReceiver"
            android:exported="false" />
    </application>
</manifest>
