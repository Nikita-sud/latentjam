<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Media access for the library scanner: split by API level. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Background playback via the Media3 session service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Library analysis runs for minutes; dataSync rather than mediaPlayback
         because it is unrelated to whether anything is playing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Attaching the system equalizer effect to our audio session. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LatentJam">

        <!-- Fully-qualified: the activity class is compiled in :composeApp
             (androidMain), not in this zero-source packaging module. -->
        <activity
            android:name="io.github.nikitasud.latentjam.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Class compiled in :core:playback (androidMain); hosts the
             ExoPlayer + MediaSession for background playback. -->
        <service
            android:name="io.github.nikitasud.latentjam.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Class compiled in :composeApp (androidMain); keeps the process alive
             while the library is analysed so the progress it reports is true. -->
        <service
            android:name="io.github.nikitasud.latentjam.app.IndexingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
