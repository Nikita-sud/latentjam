/* LatentJam system-prompt localization. */
/* The Music library grant is the one permission iOS asks for, so its usage
   description is the only key here; it must stay in sync with
   NSAppleMusicUsageDescription in iosApp/Info.plist, which is the fallback. */

"NSAppleMusicUsageDescription" = "LatentJam uses your on-device music library to organize tracks and make private recommendations locally.";
