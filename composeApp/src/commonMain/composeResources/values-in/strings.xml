<?xml version="1.0" encoding="utf-8"?>
<!--
  REQUIRED DUPLICATE of values-id/strings.xml. Keep the two byte-identical:
  edit values-id, then copy the file here. This is not a mistake.

  java.util.Locale reports Indonesian as the legacy code "in" on API 24 to 34,
  and as "id" only from API 35 onwards. Compose Multiplatform matches locale
  qualifiers by exact string and performs no normalisation, so both folders
  are needed to cover the supported API range.
-->
<!--
  Copyright (c) 2026 LatentJam Project
  SPDX-License-Identifier: Apache-2.0

  Indonesian translation of values/strings.xml.

  Placeholders are POSITIONAL (%1$s / %1$d) and keep their numbers.
  Apostrophes and quotation marks are written RAW: Compose Multiplatform only
  unescapes \uXXXX, \n, \t and \\, so a backslash would reach the UI.
  "LatentJam" and "SMART" are names and stay untranslated.
  Indonesian has no grammatical plural, so every plurals block carries the
  single required "other" category and never reduplicates after a numeral.
-->
