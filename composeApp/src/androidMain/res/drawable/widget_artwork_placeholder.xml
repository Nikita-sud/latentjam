<?xml version="1.0" encoding="utf-8"?>
<!-- A quiet cover tile; artwork still fills this square when a song supplies its own image. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path android:pathData="M0,0 H100 V100 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="22"
                android:centerY="20"
                android:gradientRadius="95"
                android:startColor="#FF343B40"
                android:endColor="#FF111416" />
        </aapt:attr>
    </path>
    <group android:pivotX="50" android:pivotY="52.5"
        android:scaleX="0.60" android:scaleY="0.60">
        <path android:pathData="M30,30 V75 H45"
            android:strokeColor="#FFB2BDC2" android:strokeWidth="6"
            android:strokeAlpha="0.4" android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path android:pathData="M30,30 C50,30 50,50 70,50"
            android:strokeColor="#FFB2BDC2" android:strokeWidth="7"
            android:strokeLineCap="round" />
        <path android:pathData="M70,50 C70,70 60,75 45,75"
            android:strokeColor="#FFB2BDC2" android:strokeWidth="7"
            android:strokeLineCap="round" />
        <path android:pathData="M21,30 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 Z" android:fillColor="#FFB2BDC2" />
        <path android:pathData="M61,50 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 Z" android:fillColor="#FFB2BDC2" />
        <path android:pathData="M36,75 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 Z" android:fillColor="#FFB2BDC2" />
    </group>
</vector>
