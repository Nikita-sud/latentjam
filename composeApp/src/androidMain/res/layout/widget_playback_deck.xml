<?xml version="1.0" encoding="utf-8"?>
<!-- SMART Deck: detailed state, live elapsed time, next-up, and mode controls.
     Sized for a tall 4x2 cell: large art and a full-width info column eat the
     vertical slack deliberately instead of centering a small island in a void. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_deck"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/widget_artwork_frame"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_smart_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="SMART DECK"
                    android:textColor="#8CFFFFFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_mode_chip"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/widget_mode_off"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_app_label"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_ready"
                android:textColor="#B8FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Chronometer
                    android:id="@+id/widget_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:textColor="#70FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#9FFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_next_up"
                android:textColor="#86FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_repeat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_repeat"
            android:padding="11dp"
            android:src="@drawable/ic_widget_repeat" />

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_previous"
            android:padding="12dp"
            android:src="@drawable/ic_widget_previous_light" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/widget_play_button"
            android:contentDescription="@string/widget_play"
            android:padding="12dp"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_next"
            android:padding="12dp"
            android:src="@drawable/ic_widget_next_light" />

        <ImageButton
            android:id="@+id/widget_shuffle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_shuffle"
            android:padding="11dp"
            android:src="@drawable/ic_widget_smart_mark" />
    </LinearLayout>
</LinearLayout>
