<?xml version="1.0" encoding="utf-8"?>
<!-- Cover Portal: full-bleed art with metadata and transport over a smooth bottom
     fade. The root supplies the single rounded outline for every layer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_portal"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- The empty preview has its own small mark, above the metadata/transport area.
         Keeping it separate prevents centerCrop from stretching the logo over the controls. -->
    <FrameLayout
        android:id="@+id/widget_empty_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_placeholder_surface"
        android:paddingBottom="112dp"
        android:importantForAccessibility="no">
        <ImageView
            android:id="@+id/widget_empty_mark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:tint="#FFB2BDC2"
            android:src="@drawable/ic_widget_smart_mark" />
    </FrameLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_portal_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/widget_app_label"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/widget_ready"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_icon_button"
                android:contentDescription="@string/widget_previous"
                android:padding="10dp"
                android:src="@drawable/ic_widget_previous_light" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_play_button"
                android:contentDescription="@string/widget_play"
                android:padding="10dp"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_icon_button"
                android:contentDescription="@string/widget_next"
                android:padding="10dp"
                android:src="@drawable/ic_widget_next_light" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
