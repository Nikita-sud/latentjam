  The app's press on the home screen: the launcher runs it, so it needs no code here. The button
  lands at 0.88 in 60 ms and eases back over 360 ms, the timing of the player's own buttons.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="60"
                android:interpolator="@android:interpolator/linear_out_slow_in"
                android:propertyName="scaleX"
                android:valueTo="0.88"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="60"
                android:interpolator="@android:interpolator/linear_out_slow_in"
                android:propertyName="scaleY"
                android:valueTo="0.88"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="360"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="360"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
